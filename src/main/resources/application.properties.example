server.port=8080
spring.application.name=kongbap

# MariaDB 연결 설정
spring.datasource.driver-class-name=org.mariadb.jdbc.Driver
spring.datasource.url=jdbc:mariadb://localhost:3306/kongbap?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&useSSL=false
spring.datasource.username=root
spring.datasource.password=your_password_here

# JPA / Hibernate 설정
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=false

# 백업 파일 저장 설정
kongbap.backup.directory=D:/백업 파일/KONGBAP_BACKUPS_JSON
kongbap.backup.max-count=300

# 관리자 계정 설정 (BCrypt 해시 또는 평문 비밀번호 모두 지원)
kongbap.admin.username=admin
kongbap.admin.password=your_admin_password_here

# 보안 설정 (Brute-Force 방어 및 토큰/쿠키 보안)
kongbap.security.max-login-attempts=5
kongbap.security.lockout-duration-minutes=15
# 토큰 서명용 비밀키 (미입력 시 기본 난수/솔트 적용)
kongbap.security.token-secret=your_strong_random_token_secret_here
# HTTPS 환경에서 운영 시 true로 설정 (SameSite=Lax 쿠키에 Secure 플래그 적용)
kongbap.security.cookie.secure=false
# CORS 허용 도메인 (쉼표로 구분)
kongbap.cors.allowed-origins=http://localhost:8080,http://localhost:63342,http://127.0.0.1:8080,http://127.0.0.1:63342

# 시스템 내부 에러 및 스택트레이스 노출 방지
server.error.include-stacktrace=never
server.error.include-message=never
server.error.include-binding-errors=never
server.error.whitelabel.enabled=false

# 세션 유효시간 1시간 설정 (브라우저를 닫았다 열어도 1시간 유지)
server.servlet.session.timeout=1h
server.servlet.session.cookie.max-age=3600

# YouTube Data API v3 설정 (Google Cloud Console에서 발급받은 API 키 입력)
# 미등록 시 oEmbed 방식으로 기본 정보(제목 등)를 자동 조회합니다.
youtube.api.key=

# 웹 및 API 전송 압축 최적화 (GZIP) - JSON 및 정적 에셋 전송량 대폭 절감
server.compression.enabled=true
server.compression.mime-types=text/html,text/xml,text/plain,text/css,text/javascript,application/javascript,application/json,application/xml
server.compression.min-response-size=1024

